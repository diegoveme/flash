# Copy to apps/api/.env to override defaults. Never commit .env.
# Every value below is optional for local development: defaults use in-memory
# adapters, local disk storage and a file outbox instead of SES.

# Drivers
# DB_DRIVER=memory            # memory | dynamodb
# CACHE_DRIVER=memory         # memory | redis
# STORAGE_DRIVER=local        # local | s3
# MAIL_DRIVER=outbox          # outbox | ses

# HTTP (local dev server)
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# APP_BASE_URL=http://localhost:5173

# Security
# BCRYPT_COST=12
# Secret used only by the local storage emulator to sign upload policies.
# LOCAL_STORAGE_SIGNING_SECRET=change-me

# AWS (production values come from the SAM template, not from this file)
# AWS_REGION=us-east-1
# DYNAMODB_TABLE=flash
# DYNAMODB_ENDPOINT=
# S3_BUCKET=
# IMAGES_BASE_URL=https://<cloudfront-domain>
# SES_FROM_ADDRESS=no-reply@example.com
# REDIS_URL=redis://localhost:6379
# REDIS_SECRET_ARN=
