# Local Docker profile (see docker-compose.yml at the repo root).
# Only local endpoints live here. No real credentials.
DB_DRIVER=dynamodb
CACHE_DRIVER=redis
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=flash-local
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
# DynamoDB Local ignores credentials, but the AWS SDK requires some value.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
